{
  "name": "uml-orbit",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first UML editor with smart routing, Java editing assistance and source-to-diagram import.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node server.mjs --dist",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "bench": "node tests/benchmark.mjs",
    "bench:layout": "node tests/layout-benchmark.mjs",
    "validate": "npm run check && npm test && npm run build"
  },
  "engines": { "node": ">=22" }
}
